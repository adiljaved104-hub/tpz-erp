APP_NAME="Tech Point Zone ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=tpz-erp-session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
EMAIL_NOTIFICATIONS_ENABLED=true
MAIL_ENCRYPTION=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="notifications@techpointzone.com"
MAIL_FROM_NAME="Tech Point Zone ERP"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

HIKVISION_ENABLED=false
HIKVISION_SCHEDULED_SYNC_ENABLED=false
HIKVISION_SCHEME=http
HIKVISION_HOST=
HIKVISION_PORT=80
HIKVISION_USERNAME=
HIKVISION_PASSWORD=
HIKVISION_TIMEOUT=10
HIKVISION_SYNC_OVERLAP_MINUTES=10
HIKVISION_SYNC_INTERVAL_MINUTES=5

# ERP backup storage, retention, health, and schedule. Keep the backup path
# outside the deployed release directory in production.
ERP_BACKUP_PATH=
ERP_BACKUP_STORAGE_ENABLED=true
ERP_BACKUP_KEEP_DAILY=14
ERP_BACKUP_KEEP_WEEKLY=8
ERP_BACKUP_KEEP_MONTHLY=6
ERP_BACKUP_MAX_AGE_HOURS=26
ERP_BACKUP_SCHEDULE_ENABLED=false
ERP_BACKUP_SCHEDULE_TIME=02:00
ERP_BACKUP_OVERLAP_MINUTES=180
ERP_MYSQLDUMP_BINARY=mysqldump
ERP_MYSQL_BINARY=mysql

# Staging demo data is denied unless every safeguard is configured explicitly.
ERP_DEMO_DATA_ENABLED=false
ERP_DEMO_DATABASE_NAME=
ERP_DEMO_USER_PASSWORD=
