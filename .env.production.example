APP_NAME="TPZ ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://erp.example.com
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_TIMEZONE=+00:00
MYSQL_ATTR_SSL_CA=

# Comma-separated IP addresses/CIDR ranges for the actual reverse proxy only.
TRUSTED_PROXIES=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_COOKIE=tpz-erp-session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
DB_QUEUE_AFTER_COMMIT=true
QUEUE_FAILED_DRIVER=database-uuids
QUEUE_STALE_AFTER=600
BROADCAST_CONNECTION=log

# Database Email Settings are authoritative when configured. These values are
# a safe fallback only; never commit production SMTP credentials.
EMAIL_NOTIFICATIONS_ENABLED=true
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="TPZ ERP"

FILESYSTEM_DISK=local

# Use an absolute path on a durable volume outside the deployed release.
ERP_BACKUP_PATH=
ERP_BACKUP_STORAGE_ENABLED=true
ERP_BACKUP_KEEP_DAILY=14
ERP_BACKUP_KEEP_WEEKLY=8
ERP_BACKUP_KEEP_MONTHLY=6
ERP_BACKUP_MAX_AGE_HOURS=26
ERP_BACKUP_SCHEDULE_ENABLED=true
ERP_BACKUP_SCHEDULE_TIME=02:00
ERP_BACKUP_OVERLAP_MINUTES=180
ERP_MYSQLDUMP_BINARY=mysqldump
ERP_MYSQL_BINARY=mysql

# Keep device synchronization disabled until its worker/network phase is approved.
HIKVISION_ENABLED=false
HIKVISION_SCHEDULED_SYNC_ENABLED=false
HIKVISION_SCHEME=https
HIKVISION_HOST=
HIKVISION_PORT=443
HIKVISION_USERNAME=
HIKVISION_PASSWORD=
HIKVISION_TIMEOUT=10
HIKVISION_SYNC_OVERLAP_MINUTES=10
HIKVISION_SYNC_INTERVAL_MINUTES=5

VITE_APP_NAME="${APP_NAME}"
